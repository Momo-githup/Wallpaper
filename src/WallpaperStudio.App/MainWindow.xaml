<Window x:Class="WallpaperStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="Wallpaper Studio" Width="1180" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Grid Margin="28,22,28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Wallpaper Studio" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="让桌面换一种心情" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="导入图片" Command="{Binding ImportFilesCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="导入文件夹" Command="{Binding ImportFolderCommand}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="28,0,28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14"><Grid>
                <ListBox ItemsSource="{Binding Wallpapers}" SelectedItem="{Binding SelectedWallpaper}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Width="205" Height="155" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="5"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
                        <Border CornerRadius="5" ClipToBounds="True" Background="#11141A"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border>
                        <Grid Grid.Row="1" Margin="5,5,5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Resolution}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></Grid>
                    </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Wallpapers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="图库还是空的" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="导入图片，或者直接把图片拖到这里" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
            </Grid></Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="当前选择" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><Border Grid.Row="1" Background="#11141A" CornerRadius="8" ClipToBounds="True"><Image Source="{Binding SelectedWallpaper.Thumbnail}" Stretch="Uniform"/></Border>
                <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding SelectedWallpaper.DisplayName, TargetNullValue=请选择一张壁纸}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"><Run Text="{Binding SelectedWallpaper.Resolution}"/><Run Text="  ·  "/><Run Text="{Binding SelectedWallpaper.FileSizeText}"/></TextBlock><TextBlock Text="{Binding SelectedWallpaper.FilePath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="显示方式" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Height="34"/><CheckBox Content="随 Windows 启动" IsChecked="{Binding StartWithWindows}" Foreground="White" Margin="0,18,0,0"/><Button Content="保存设置" Command="{Binding SavePreferencesCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/></StackPanel>
                <StackPanel Grid.Row="4"><Button Content="设为壁纸" Command="{Binding ApplyWallpaperCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="全屏预览" Command="{Binding PreviewCommand}" Margin="0,0,5,0"/><Button Grid.Column="1" Content="移出图库" Command="{Binding RemoveCommand}" Margin="5,0,0,0"/></Grid></StackPanel>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#12151C" Padding="28,0"><Grid><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><ProgressBar IsIndeterminate="True" Width="120" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></Grid></Border>
    </Grid>
</Window>
