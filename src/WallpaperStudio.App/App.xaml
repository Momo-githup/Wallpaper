<Application x:Class="WallpaperStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0C0F15" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151A23" />
        <SolidColorBrush x:Key="CardBrush" Color="#1B222E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8068FF" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#2A3240" />
        <SolidColorBrush x:Key="InputBrush" Color="#11161E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8F9FC" />
            <Setter Property="Background" Value="#29313F" />
            <Setter Property="BorderBrush" Value="#344052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="InteractionOverlay" Background="White" CornerRadius="9"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.965" ScaleY="0.965" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#B5A8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#A596FF" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8F7AFF" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter Property="Opacity" Value="0.65" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#8F7AFF" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WallpaperListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="ItemRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="SelectionChrome" CornerRadius="11" BorderThickness="2"
                                    BorderBrush="Transparent" Background="Transparent" Padding="2">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="ItemOverlay" CornerRadius="11" Background="White"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemOverlay" Storyboard.TargetProperty="Opacity" To="0.055" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionChrome" Property="Background" Value="#247C5CFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#2B3240" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
